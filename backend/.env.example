# ---- Server ----
NODE_ENV=development
PORT=4000
MONGODB_URI=mongodb://localhost:27017/passescort
# Public base URL of this API (Paystack returns here; mock checkout lives here).
PUBLIC_API_URL=http://localhost:4000
# Deep-link host printed on share cards / invites, and the app's URL scheme.
LINK_HOST=https://passescort.app
APP_SCHEME=passescort
# Comma-separated, or * for any.
CORS_ORIGINS=*

# ---- Auth (PRD §4: Firebase) ----
# firebase in production; "dev" accepts "Bearer dev:<uid>" tokens for local runs (refused in production).
AUTH_MODE=firebase
# Service account: a file path, or the JSON inline (for hosts without files).
FIREBASE_SERVICE_ACCOUNT_PATH=./firebase-service-account.json
# FIREBASE_SERVICE_ACCOUNT_JSON={"type":"service_account",...}

# ---- AI explanations (PRD §5.5) ----
# groq | gemini | mock (mock is refused in production). The other provider is used as a fallback if its key is set.
# Both have free tiers. Explanations are cached per question, so run `npm run ai:pregenerate` once
# (resumable, stays inside free daily limits) and AI Explain costs nothing at runtime.
AI_PROVIDER=groq
GROQ_API_KEY=
GROQ_MODEL=openai/gpt-oss-120b
GEMINI_API_KEY=
GEMINI_MODEL=gemini-flash-lite-latest

# ---- Payments (PRD §5.8) ----
# paystack | mock (mock is refused in production). Use sk_test_… keys until launch.
PAYMENTS_MODE=paystack
PAYSTACK_SECRET_KEY=

# ---- Push notifications (PRD §4: Firebase Cloud Messaging) ----
# expo: delivered through Expo's push service, which uses your Firebase project's FCM credentials on Android
# (upload the FCM V1 service-account key with `eas credentials`) and APNs on iOS. log: record only.
PUSH_MODE=expo
EXPO_ACCESS_TOKEN=
# Schedule `npm run push:reminders` hourly (it only messages each student once a day, in the evening).

# ---- Duels ----
# Matchmaking offers a clearly labelled practice bot after this many ms (0 = never).
DUEL_BOT_AFTER_MS=20000
