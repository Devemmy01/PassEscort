# Copy to .env (Expo inlines EXPO_PUBLIC_* at build time).

# The PassEscort API (backend/). On a phone, use your computer's LAN IP, e.g. http://192.168.1.20:4000
EXPO_PUBLIC_API_URL=http://localhost:4000

# firebase for real builds; dev pairs with a backend running AUTH_MODE=dev (any email + 8-char password).
EXPO_PUBLIC_AUTH_MODE=dev
EXPO_PUBLIC_FIREBASE_API_KEY=
EXPO_PUBLIC_FIREBASE_AUTH_DOMAIN=
EXPO_PUBLIC_FIREBASE_PROJECT_ID=
EXPO_PUBLIC_FIREBASE_APP_ID=

# Google sign-in (Firebase console → Authentication → Sign-in method → Google).
# The *web* OAuth client ID, used on Android, iOS and web:
EXPO_PUBLIC_GOOGLE_WEB_CLIENT_ID=
# iOS only: the reversed iOS client ID from GoogleService-Info.plist (com.googleusercontent.apps.…).
# Leave empty to build without the Google Sign-In config plugin.
EXPO_PUBLIC_GOOGLE_IOS_URL_SCHEME=

# Native build settings (read by app.config.ts, not bundled into the app):
# google-services.json from the Firebase console (Android app app.passescort) — needed for FCM push.
# GOOGLE_SERVICES_JSON=./google-services.json
# EAS project ID (`eas init` prints it). Push tokens are scoped to it; without it the app skips push registration.
# EAS_PROJECT_ID=

# Must match LINK_HOST on the backend and the App Links / Universal Links domain in app.json.
EXPO_PUBLIC_LINK_HOST=https://passescort.app

# Set to "prototype" to open the design prototype (demo data) instead of the app.
# EXPO_PUBLIC_START=prototype
