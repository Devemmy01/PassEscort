{
  "expo": {
    "name": "PassEscort",
    "slug": "passescort",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "scheme": "passescort",
    "userInterfaceStyle": "light",
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "app.passescort",
      "associatedDomains": [
        "applinks:passescort.app"
      ]
    },
    "android": {
      "adaptiveIcon": {
        "backgroundColor": "#FFFFFF",
        "foregroundImage": "./assets/android-icon-foreground.png",
        "backgroundImage": "./assets/android-icon-background.png",
        "monochromeImage": "./assets/android-icon-monochrome.png"
      },
      "predictiveBackGestureEnabled": false,
      "package": "app.passescort",
      "intentFilters": [
        {
          "action": "VIEW",
          "autoVerify": true,
          "data": [
            {
              "scheme": "https",
              "host": "passescort.app",
              "pathPrefix": "/d/"
            },
            {
              "scheme": "https",
              "host": "passescort.app",
              "pathPrefix": "/r/"
            }
          ],
          "category": [
            "BROWSABLE",
            "DEFAULT"
          ]
        }
      ]
    },
    "web": {
      "favicon": "./assets/favicon.png"
    },
    "plugins": [
      "expo-sqlite",
      [
        "expo-splash-screen",
        {
          "backgroundColor": "#F8FAFC",
          "image": "./assets/splash-icon.png",
          "imageWidth": 110,
          "resizeMode": "contain"
        }
      ],
      "expo-font",
      "expo-sharing",
      "expo-web-browser",
      [
        "expo-notifications",
        {
          "color": "#042455"
        }
      ]
    ]
  }
}
